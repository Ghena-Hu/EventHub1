@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<div class="hero text-center text-white py-5">

    <h1 class="fw-bold display-4">EventHub 🎨</h1>

    <p class="lead mt-2">
        Erlebe kreative Events in deiner Stadt
    </p>

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-light btn-lg mt-3">
        Events entdecken
    </a>

    <a asp-controller="Events"
       asp-action="Create"
       class="btn btn-outline-light btn-lg mt-3 ms-2">
        + Event erstellen
    </a>

</div>

<!-- CATEGORIES -->
<div class="container mt-5 text-center">

    <h4 class="mb-3">🔥 Kategorien</h4>

    <div class="d-flex flex-wrap justify-content-center gap-2">

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Party"
           class="btn btn-danger">
            Party
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Gaming"
           class="btn btn-primary">
            Gaming
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Kino"
           class="btn btn-warning text-dark">
            Kino
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Sport"
           class="btn btn-success">
            Sport
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Musik"
           class="btn btn-info">
            Musik
        </a>

    </div>
</div>

<!-- FEATURED EVENTS (STATIC PREVIEW) -->
<div class="container mt-5">

    <h4 class="mb-3 text-center">⭐ Beliebte Events</h4>

    <div class="row g-4">

        <!-- CARD -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">

                <img class="card-img-top"
                     src="data:image/jpeg;base64,"
                     style="height:200px; object-fit:cover;" />

                <div class="card-body">
                    <h5>🎮 Gaming Night</h5>
                    <p class="text-muted">Spaß mit Freunden</p>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">

                <img class="card-img-top"
                     src="https://img.magnific.com/premium-vector/movie-theater-signboard-blue_34230-295.jpg?semt=ais_hybrid&w=740&q=80"
                     style="height:200px; object-fit:cover;" />

                <div class="card-body">
                    <h5>🎬 Movie Night</h5>
                    <p class="text-muted">Filme & Snacks</p>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">

                <img class="card-img-top"
                     src="https://static.vecteezy.com/ti/gratis-vektor/t2/11277704-bbq-fest-utegrill-bakgrund-med-brazier-grill-biffar-kott-mat-grillad-gronsaker-pa-hem-vektor-tecknad-serie-illustration-for-baner-semester-kort-sommar-picknick-flygblad-annons-affisch-vector.jpg"
                     style="height:200px; object-fit:cover;" />

                <div class="card-body">
                    <h5>🍔 Grill Event</h5>
                    <p class="text-muted">Essen & Freunde</p>
                </div>

            </div>
        </div>

    </div>
</div>