@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<div class="hero text-center text-white py-5">

    <h1 class="fw-bold display-4">EventHub 🎨</h1>

    <p class="lead mt-2">
        Erlebe kreative Events in deiner Stadt
    </p>

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-light btn-lg mt-3">
        Events entdecken
    </a>

    <a asp-controller="Events"
       asp-action="Create"
       class="btn btn-outline-light btn-lg mt-3 ms-2">
        + Event erstellen
    </a>

</div>

<!-- CATEGORIES -->
<div class="container mt-5 text-center">

    <h4 class="mb-3">🔥 Kategorien</h4>

    <div class="d-flex flex-wrap justify-content-center gap-2">

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Party"
           class="btn btn-danger">
            🎉 Party
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Gaming"
           class="btn btn-primary">
            🎮 Gaming
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Kino"
           class="btn btn-warning text-dark">
            🎬 Kino
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Sport"
           class="btn btn-success">
            ⚽ Sport
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Musik"
           class="btn btn-info text-white">
            🎵 Musik
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Lernen"
           class="btn btn-secondary">
            📚 Lernen
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Reisen"
           class="btn btn-dark">
            ✈️ Reisen
        </a>

        <a asp-controller="Events"
           asp-action="ByCategory"
           asp-route-category="Food"
           class="btn btn-food">
            🍔 Food
        </a>

    </div>
</div>

<!-- FEATURED EVENTS (STATIC PREVIEW) -->
<div class="container mt-5">

    <h4 class="mb-3 text-center">⭐ Beliebte Events</h4>

    <div class="row g-4">

        <!-- CARD -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">

                <img class="card-img-top"
                     src="https://platform.vox.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/13601737/VIDEOGAME_ADDICTION.jpg?quality=90&strip=all&crop=0,0,100,100"
                     style="height:200px; object-fit:cover;" />

                <div class="card-body">
                    <h5>🎮 Gaming Night</h5>
                    <p class="text-muted">Spaß mit Freunden</p>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">

                <img class="card-img-top"
                     src="https://img.magnific.com/premium-photo/flying-popcorn-3d-glasses-film-reel-clapboard-yellow-background-cinema-movie-concept-3d_989822-1302.jpg?semt=ais_hybrid&w=740&q=80"
                     style="height:200px; object-fit:cover;" />

                <div class="card-body">
                    <h5>🎬 Movie Night</h5>
                    <p class="text-muted">Filme & Snacks</p>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">

                <img class="card-img-top"
                     src="https://static.vecteezy.com/system/resources/previews/023/823/377/non_2x/delicious-barbecue-flat-style-white-background-free-vector.jpg"
                     style="height:200px; object-fit:cover;" />

                <div class="card-body">
                    <h5>🍔 Grill Event</h5>
                    <p class="text-muted">Essen & Freunde</p>
                </div>

            </div>
        </div>

    </div>
</div>