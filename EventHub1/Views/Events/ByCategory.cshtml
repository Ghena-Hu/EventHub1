@model IEnumerable<EventHub1.Models.Event>

@{
    ViewData["Title"] = "Kategorie: " + ViewBag.Category;
}

<h2 class="mb-3">
    🔥 Kategorie: @ViewBag.Category
</h2>

<!-- FILTER BUTTONS -->
<div class="d-flex flex-wrap gap-2 mb-4">

    <a asp-action="Index" class="btn btn-dark">
        Alle
    </a>

    <a asp-action="ByCategory" asp-route-category="Party" class="btn btn-danger">
        🎉 Party
    </a>

    <a asp-action="ByCategory" asp-route-category="Gaming" class="btn btn-primary">
        🎮 Gaming
    </a>

    <a asp-action="ByCategory" asp-route-category="Kino" class="btn btn-warning text-dark">
        🎬 Kino
    </a>

    <a asp-action="ByCategory" asp-route-category="Sport" class="btn btn-success">
        ⚽ Sport
    </a>

    <a asp-action="ByCategory" asp-route-category="Musik" class="btn btn-info text-white">
        🎵 Musik
    </a>

    <a asp-action="ByCategory" asp-route-category="Lernen" class="btn btn-secondary">
        📚 Lernen
    </a>

    <a asp-action="ByCategory" asp-route-category="Reisen" class="btn btn-dark">
        ✈️ Reisen
    </a>

    <a asp-action="ByCategory" asp-route-category="Food" class="btn btn-outline-danger">
        🍔 Food
    </a>

</div>

<!-- EVENTS -->
<div class="row g-4">

    @foreach (var item in Model)
    {
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <span class="badge bg-dark mb-2">
                        @item.Category
                    </span>

                    <h5>@item.Title</h5>

                    <p class="text-muted">
                        📍 @item.Location
                    </p>

                    <p>
                        📅 @item.Date
                    </p>

                    <a class="btn btn-primary w-100"
                       asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>

                </div>

            </div>

        </div>
    }

</div>