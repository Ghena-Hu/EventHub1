@model EventHub1.Models.Event

@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Event Details";

    var userId = UserManager.GetUserId(User);
}

<!-- HEADER -->
<div class="text-center mb-4">

    <h1 class="fw-bold">@Model.Title</h1>

    <p class="text-muted">
        📍 @Model.Location • 📅 @Model.Date.ToString("dd.MM.yyyy HH:mm")
    </p>

    <p>
        👤 Erstellt von: <strong>@ViewBag.OwnerName</strong>
    </p>

</div>

<!-- IMAGE -->
<div class="text-center mb-4">

    <img src="@(string.IsNullOrEmpty(Model.ImageUrl)
                         ? "https://images.unsplash.com/photo-1521737604893"
                         : Model.ImageUrl)"
         class="img-fluid rounded shadow"
         style="max-height: 400px; object-fit: cover;" />

</div>

<!-- EVENT INFO -->
<div class="card p-4 mb-4">

    <h4 class="mb-3">Event Informationen</h4>

    <p>@Model.Description</p>

    <hr />

    <p>📌 Kategorie: <strong>@Model.Category</strong></p>
    <p>👥 Max Teilnehmer: <strong>@Model.MaxParticipants</strong></p>

</div>

<!-- COMMENTS -->
<div class="card p-4 mb-4">

    <h4>Kommentare</h4>

    <form asp-controller="Comments"
          asp-action="Create"
          method="post">

        <input type="hidden" name="eventId" value="@Model.Id" />

        <textarea name="text"
                  class="form-control mb-2"
                  rows="3"
                  placeholder="Schreibe einen Kommentar..."></textarea>

        <button class="btn btn-primary">
            Posten
        </button>

    </form>

    <hr />

    @if (ViewBag.Comments != null)
    {
        foreach (var c in ViewBag.Comments)
        {
            <div class="border rounded p-2 mb-2">

                <p class="mb-1">@c.Text</p>

                <small class="text-muted">
                    @c.CreatedAt
                </small>

            </div>
        }
    }

</div>

<!-- ACTIONS -->
<div class="d-flex gap-2">

    @if (Model.OwnerId == userId)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger">
            Delete
        </a>
    }

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</div>