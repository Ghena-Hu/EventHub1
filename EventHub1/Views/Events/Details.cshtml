@model EventHub1.Models.Event

@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Event Details";

    var userId = UserManager.GetUserId(User);

    var going = ViewBag.Going ?? 0;
    var maybe = ViewBag.Maybe ?? 0;
    var no = ViewBag.No ?? 0;
}

<h1>@Model.Title</h1>

<hr />

<div class="card p-3">

    <h4>Event Informationen</h4>

    <dl class="row">

        <dt class="col-sm-3">Beschreibung</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Datum</dt>
        <dd class="col-sm-9">@Model.Date</dd>

        <dt class="col-sm-3">Ort</dt>
        <dd class="col-sm-9">@Model.Location</dd>

        <dt class="col-sm-3">Max. Teilnehmer</dt>
        <dd class="col-sm-9">@Model.MaxParticipants</dd>

        <dt class="col-sm-3">Kategorie</dt>
        <dd class="col-sm-9">@Model.Category</dd>

    </dl>

</div>

<hr />

<h3>Teilnahme</h3>

<div class="btn-group">

    <a class="btn btn-success"
       href="/Participation/Join?eventId=@Model.Id&status=Going">
        👍 Ich komme
    </a>

    <a class="btn btn-warning"
       href="/Participation/Join?eventId=@Model.Id&status=Maybe">
        🤔 Vielleicht
    </a>

    <a class="btn btn-danger"
       href="/Participation/Join?eventId=@Model.Id&status=No">
        ❌ Absage
    </a>

</div>

<hr />

<h4>Aktuelle Teilnehmer</h4>

<p>👍 Kommen: <strong>@going</strong></p>
<p>🤔 Vielleicht: <strong>@maybe</strong></p>
<p>❌ Absagen: <strong>@no</strong></p>

@if (going >= Model.MaxParticipants)
{
    <div class="alert alert-danger">
        Event ist voll.
    </div>
}
else
{
    <div class="alert alert-success">
        Event ist offen.
    </div>
}

<hr />

<!-- KOMMENTAR SYSTEM -->

<h3>Kommentare</h3>

<form asp-controller="Comments"
      asp-action="Create"
      method="post">

    <input type="hidden" name="eventId" value="@Model.Id" />

    <textarea name="text"
              class="form-control"
              rows="3"
              placeholder="Schreibe einen Kommentar..."></textarea>

    <br />

    <button type="submit" class="btn btn-primary">
        Kommentar posten
    </button>

</form>

<hr />

@if (ViewBag.Comments != null)
{
    foreach (var c in ViewBag.Comments)
    {
        <div class="card mb-2">
            <div class="card-body">

                <p>@c.Text</p>

                <small class="text-muted">
                    @c.CreatedAt
                </small>

            </div>
        </div>
    }
}

<hr />

<div>

    @if (Model.OwnerId == userId)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger">
            Delete
        </a>
    }

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

</div>