@model IEnumerable<EventHub1.Models.Event>

<div class="container mt-4">

    <h2 class="mb-3">Events entdecken</h2>

    <a class="btn btn-primary mb-3" asp-action="Create">
        + Event erstellen
    </a>

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-4">

                <div class="card">

                    <img src="@(item.ImageUrl ?? "https://images.unsplash.com/photo-1521737604893")" />

                    <div class="card-body">

                        <h5>@item.Title</h5>
                        <p class="text-muted">@item.Location</p>
                        <p>@item.Date.ToString("dd.MM.yyyy")</p>

                        <a class="btn btn-primary btn-sm"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Details
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>