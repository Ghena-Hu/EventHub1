@model IEnumerable<EventHub1.Models.Event>

<div class="container mt-4">

    <h2 class="mb-3">Events entdecken</h2>

    <a asp-controller="Events"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Event erstellen
    </a>


    
    <!-- SORTIERUNG -->
    <div class="mb-3">

        <a class="btn btn-outline-primary"
           href="/Events/Index?sortOrder=new">
            Neueste zuerst
        </a>

        <a class="btn btn-outline-secondary"
           href="/Events/Index?sortOrder=old">
            Älteste zuerst
        </a>

    </div>

    <!-- KATEGORIEN -->
    <div class="mb-4">

        <a class="btn btn-outline-dark btn-sm"
           asp-action="Index">
            Alle
        </a>

        <a class="btn btn-outline-primary btn-sm"
           asp-action="ByCategory"
           asp-route-category="Party">
            Party
        </a>

        <a class="btn btn-outline-success btn-sm"
           asp-action="ByCategory"
           asp-route-category="Gaming">
            Gaming
        </a>

        <a class="btn btn-outline-warning btn-sm"
           asp-action="ByCategory"
           asp-route-category="Kino">
            Kino
        </a>

        <a class="btn btn-outline-danger btn-sm"
           asp-action="ByCategory"
           asp-route-category="Sport">
            Sport
        </a>

        <a class="btn btn-outline-info btn-sm"
           asp-action="ByCategory"
           asp-route-category="Musik">
            Musik
        </a>

        <a class="btn btn-lern btn-sm"
           asp-action="ByCategory"
           asp-route-category="Lernen">
            Lernen
        </a>

        <a class="btn btn-outline-dark btn-sm"
           asp-action="ByCategory"
           asp-route-category="Reisen">
            Reisen
        </a>

        <a class="btn btn-outline-danger btn-sm"
           asp-action="ByCategory"
           asp-route-category="Food">
            Food
        </a>

    </div>

    <!-- EVENTS -->
    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-4">

                <div class="card shadow-lg border-0 h-100">

                    <div class="position-relative">

                        <img class="card-img-top"
                             src="@(string.IsNullOrEmpty(item.ImageUrl)
                                                             ? "https://images.unsplash.com/photo-1521737604893"
                                                             : item.ImageUrl)"
                         style="height:220px; object-fit:cover;" />

                        <span class="badge bg-dark position-absolute top-0 end-0 m-2">
                            @item.Category
                        </span>

                    </div>

                    <div class="card-body">

                        <h5 class="fw-bold">
                            @item.Title
                        </h5>

                        <p class="text-muted mb-1">
                            📍 @item.Location
                        </p>

                        <p class="text-muted">
                            📅 @item.Date.ToString("dd.MM.yyyy HH:mm")
                        </p>

                        <a class="btn btn-primary w-100"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Öffnen
                        </a>

                    </div>

                </div>

            </div>
                }

    </div>

</div>